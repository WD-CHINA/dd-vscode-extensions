{
  "name": "sourcetree-launcher",
  "displayName": "SourceTree",
  "description": "从状态栏打开本机 SourceTree，并加载当前 Git 仓库。",
  "version": "0.1.1",
  "publisher": "dd-vscode-extensions",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:sourcetree.open"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sourcetree.open",
        "title": "打开当前仓库",
        "category": "SourceTree",
        "icon": "$(source-control)"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p tsconfig.build.json",
    "watch": "tsc -watch -p tsconfig.build.json",
    "test": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/sourcetree.test.ts"
  },
  "dependencies": {
    "@dd-vscode-extensions/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.8.3"
  }
}
