{
  "name": "warp-terminal",
  "displayName": "Warp 终端",
  "description": "从状态栏在当前项目根目录打开本机 Warp。",
  "version": "0.1.1",
  "publisher": "dd-vscode-extensions",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:warp.openActive"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "warp.openActive",
        "title": "在项目根目录打开",
        "category": "Warp",
        "icon": "$(terminal)"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p tsconfig.build.json",
    "watch": "tsc -watch -p tsconfig.build.json",
    "test": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/warpUri.test.ts"
  },
  "dependencies": {
    "@dd-vscode-extensions/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.8.3"
  }
}
