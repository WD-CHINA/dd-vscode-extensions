{
  "name": "feishu-launcher",
  "displayName": "飞书",
  "description": "从状态栏启动本机飞书。",
  "version": "0.1.1",
  "publisher": "dd-vscode-extensions",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:feishu.open"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "feishu.open",
        "title": "打开飞书",
        "category": "飞书",
        "icon": "$(comment-discussion)"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p tsconfig.build.json",
    "watch": "tsc -watch -p tsconfig.build.json",
    "test": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/feishuApp.test.ts"
  },
  "dependencies": {
    "@dd-vscode-extensions/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.8.3"
  }
}
