{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "运行 Warp 扩展",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/extensions/warp-terminal"],
      "outFiles": ["${workspaceFolder}/extensions/warp-terminal/out/**/*.js"],
      "preLaunchTask": "${defaultBuildTask}"
    },
    {
      "name": "运行飞书扩展",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/extensions/feishu-launcher"],
      "outFiles": ["${workspaceFolder}/extensions/feishu-launcher/out/**/*.js"],
      "preLaunchTask": "${defaultBuildTask}"
    },
    {
      "name": "运行 SourceTree 扩展",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/extensions/sourcetree-launcher"],
      "outFiles": ["${workspaceFolder}/extensions/sourcetree-launcher/out/**/*.js"],
      "preLaunchTask": "${defaultBuildTask}"
    }
  ]
}
